# Sao chép thành .env.local nếu muốn ghi đè cấu hình mặc định trong src/config/firebase.ts

# 'firebase' (mặc định) | 'local' (lưu trên trình duyệt, không cần máy chủ)
VITE_BACKEND=firebase

# Cấu hình web app Firebase (Project settings › General › Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
