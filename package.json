{
  "name": "cloud9-cafe-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloud 9 Bakery · Cafe — ứng dụng gọi món (mobile-first, sẵn sàng chuyển sang Zalo Mini App)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && vite build --mode single",
    "dev:demo": "vite --host --mode demo",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
